@model UniversityDbApp.Models.Teacher
@{ ViewData["Title"] = "Удалить преподавателя"; }
<div class="page-wrap form-page"><a class="back-link" asp-action="Index">← Все преподаватели</a><section class="panel confirm-panel"><div class="feature-icon violet">!</div><div class="eyebrow">ПОДТВЕРЖДЕНИЕ</div><h1>Удалить преподавателя?</h1><p>Профиль @Model.FirstName @Model.LastName (@Model.Department?.Name) будет удалён из базы данных.</p><form asp-action="Delete" asp-route-id="@Model.Id"><button class="button button-danger">Удалить профиль</button><a class="button button-outline" asp-action="Index">Отмена</a></form></section></div>
