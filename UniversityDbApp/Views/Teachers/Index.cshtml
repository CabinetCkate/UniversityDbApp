@model IEnumerable<UniversityDbApp.Models.Teacher>
@{ ViewData["Title"] = "Преподаватели"; }
<div class="page-wrap"><div class="page-heading"><div><div class="eyebrow">АКАДЕМИЧЕСКОЕ СООБЩЕСТВО</div><h1>Преподаватели</h1><p>Специалисты и их связи с кафедрами.</p></div><a class="button button-primary" asp-action="Create">＋ Добавить преподавателя</a></div><form method="get" class="filter-bar"><div class="search-field"><span>⌕</span><input name="search" value="@ViewBag.Search" placeholder="Имя или электронная почта" /></div><select name="departmentId" asp-items="ViewBag.DepartmentId"><option value="">Все кафедры</option></select><button class="button button-small button-outline">Фильтровать</button><a class="clear-link" asp-action="Index">Сбросить</a></form><section class="panel table-panel"><div class="table-scroll"><table><thead><tr><th>Преподаватель</th><th>Должность</th><th>Кафедра</th><th>Учёная степень</th><th>Дата приёма</th><th></th></tr></thead><tbody>@foreach (var t in Model) { <tr><td><div class="teacher-cell"><span class="teacher-avatar">@t.FirstName[0]@t.LastName[0]</span><span><a asp-action="Details" asp-route-id="@t.Id">@t.FirstName @t.LastName</a><small>@t.Email</small></span></div></td><td>@t.Position</td><td><span class="dept-pill">@t.Department?.Name</span></td><td>@t.AcademicDegree</td><td>@t.HireDate.ToString("dd.MM.yyyy")</td><td class="actions-cell"><a asp-action="Edit" asp-route-id="@t.Id">Изменить</a><a asp-action="Delete" asp-route-id="@t.Id">Удалить</a></td></tr> }</tbody></table>@if (!Model.Any()) { <div class="empty-state">Подходящих записей не найдено.</div> }</div><div class="table-footer">Показано записей: <strong>@Model.Count()</strong><span>Все данные получены из SQL Server</span></div></section></div>
