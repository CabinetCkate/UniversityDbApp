@model UniversityDbApp.Models.Teacher
@{ ViewData["Title"] = Model.FirstName + " " + Model.LastName; }
<div class="page-wrap"><a class="back-link" asp-action="Index">← Все преподаватели</a><div class="profile-card panel"><div class="profile-avatar">@Model.FirstName[0]@Model.LastName[0]</div><div><div class="eyebrow">ПРЕПОДАВАТЕЛЬ · @Model.Department?.Code</div><h1>@Model.FirstName @Model.LastName</h1><p>@Model.Position · @Model.Department?.Name</p></div><a class="button button-outline" asp-action="Edit" asp-route-id="@Model.Id">Изменить профиль</a></div><div class="detail-cards"><article><span>ЭЛЕКТРОННАЯ ПОЧТА</span><strong>@Model.Email</strong></article><article><span>ТЕЛЕФОН</span><strong>@(Model.PhoneNumber ?? "Не указан")</strong></article><article><span>УЧЁНАЯ СТЕПЕНЬ</span><strong>@Model.AcademicDegree</strong></article><article><span>ДАТА ПРИЁМА</span><strong>@Model.HireDate.ToString("dd MMMM yyyy")</strong></article></div></div>
