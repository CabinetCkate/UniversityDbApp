@model UniversityDbApp.Models.Product
@{ ViewData["Title"] = "Новый товар"; }
<div class="page-wrap form-page"><a class="back-link" asp-action="Index">← Лаборатория ORM</a><div class="page-heading"><div><div class="eyebrow">ORM · PRODUCT</div><h1>Новый товар</h1><p>Укажите внешний ключ существующей категории.</p></div></div><form asp-action="CreateProduct" class="panel form-panel"><div asp-validation-summary="ModelOnly" class="validation"></div><div class="form-grid"><div class="field"><label asp-for="Name">Название товара</label><input asp-for="Name"/><span asp-validation-for="Name"></span></div><div class="field"><label asp-for="Price">Цена · ₸</label><input asp-for="Price" type="number" step="0.01"/><span asp-validation-for="Price"></span></div><div class="field"><label asp-for="CategoryId">Категория · FK</label><select asp-for="CategoryId" asp-items="ViewBag.CategoryId"><option value="">Выберите категорию</option></select><span asp-validation-for="CategoryId"></span></div><div class="field field-full"><label asp-for="Description">Описание</label><textarea asp-for="Description" rows="4"></textarea><span asp-validation-for="Description"></span></div></div><div class="form-footer"><a class="button button-outline" asp-action="Index">Отмена</a><button class="button button-primary">Сохранить товар</button></div></form></div>
