@model IEnumerable<UniversityDbApp.Models.Category>
@{ ViewData["Title"] = "Лаборатория ORM"; }
<div class="page-wrap"><div class="page-heading"><div><div class="eyebrow">УЧЕБНЫЙ МОДУЛЬ · ENTITY FRAMEWORK CORE</div><h1>Лаборатория ORM</h1><p>Категории и товары демонстрируют связь один-ко-многим.</p></div><div class="heading-actions"><a class="button button-outline" asp-action="CreateCategory">＋ Категория</a><a class="button button-primary" asp-action="CreateProduct">＋ Товар</a></div></div><div class="relation-strip"><span class="schema-token">Category <small>PK · Id</small></span><span class="relation-line">1 <i></i> N</span><span class="schema-token">Product <small>FK · CategoryId</small></span><span class="relation-caption">Одна категория объединяет несколько товаров</span></div><div class="orm-grid">@foreach (var c in Model) { <section class="panel orm-card"><div class="orm-card-head"><div><span class="schema-label">CATEGORY · PK @c.Id</span><h2>@c.Name</h2></div><span class="count-badge">@c.Products.Count записей</span></div><p>@c.Description</p><div class="product-list">@foreach (var p in c.Products) { <div class="product-row"><div><strong>@p.Name</strong><small>Product · FK CategoryId = @c.Id</small></div><b>@p.Price.ToString("N0") ₸</b></div> }</div></section> } @if (!Model.Any()) { <div class="empty-state">Каталог пуст.</div> }</div></div>
