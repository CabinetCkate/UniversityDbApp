<!DOCTYPE html>
<html lang="ru" data-theme="dark">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Nexus University</title>
    <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (ViewContext.RouteData.Values["controller"]?.ToString() != "Home")
    {
        <aside class="sidebar"><a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">N</span><span>NEXUS<small>UNIVERSITY</small></span></a>
            <div class="side-label">РАБОЧЕЕ ПРОСТРАНСТВО</div>
            <nav class="side-nav"><a asp-controller="Dashboard" asp-action="Index"><i data-lucide="layout-dashboard"></i><span>Обзор</span></a><a asp-controller="Departments" asp-action="Index"><i data-lucide="network"></i><span>Кафедры</span></a><a asp-controller="Teachers" asp-action="Index"><i data-lucide="users-round"></i><span>Преподаватели</span></a></nav>
            <div class="side-label lab-label">ОБУЧЕНИЕ</div><nav class="side-nav"><a asp-controller="OrmLab" asp-action="Index"><i data-lucide="boxes"></i><span>Лаборатория ORM</span></a><a asp-controller="Database" asp-action="Index"><i data-lucide="database"></i><span>Архитектура БД</span></a></nav>
            <div class="sidebar-bottom"><div class="status-dot"></div><span>Система готова</span><button class="theme-toggle" type="button" aria-label="Переключить тему"><i data-lucide="sun-moon"></i></button></div>
        </aside>
    }
    <main class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "public-main" : "app-main")">
        @if (ViewContext.RouteData.Values["controller"]?.ToString() != "Home")
        {
            <header class="topbar"><div class="breadcrumbs"><a asp-controller="Dashboard" asp-action="Index">Nexus</a><span>/</span><span>@ViewData["Title"]</span></div><div class="top-actions"><span class="live-status"><i></i> DATABASE LIVE</span><a class="avatar" asp-controller="Home" asp-action="Index">NU</a></div></header>
        }
        @if (TempData["Success"] is string success) { <div class="toast toast-ok">✓ @success</div> }
        @if (TempData["Error"] is string error) { <div class="toast toast-error">! @error</div> }
        @RenderBody()
    </main>
    <script src="https://cdn.jsdelivr.net/npm/lucide@0.468.0/dist/umd/lucide.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.161.0/build/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
