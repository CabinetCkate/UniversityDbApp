@model UniversityDbApp.ViewModels.DashboardViewModel
@{ ViewData["Title"] = "Обзор"; }
<div class="page-wrap">
    <div class="page-heading"><div><div class="eyebrow">ПОНЕДЕЛЬНИК · АКАДЕМИЧЕСКАЯ СРЕДА</div><h1>Обзор системы</h1><p>Данные университета в реальном времени.</p></div><a class="button button-primary" asp-controller="Departments" asp-action="Create">＋ Новая кафедра</a></div>
    <div class="stat-grid"><article class="stat-card"><div class="stat-top"><span>Кафедры</span><i class="stat-symbol purple">⌘</i></div><strong data-count="@Model.DepartmentCount">@Model.DepartmentCount</strong><small><i class="positive">↗</i> Академические подразделения</small><div class="stat-spark purple-line"></div></article><article class="stat-card"><div class="stat-top"><span>Преподаватели</span><i class="stat-symbol blue">♙</i></div><strong data-count="@Model.TeacherCount">@Model.TeacherCount</strong><small><i class="positive">↗</i> В академическом составе</small><div class="stat-spark blue-line"></div></article><article class="stat-card"><div class="stat-top"><span>Категории каталога</span><i class="stat-symbol mint">⌬</i></div><strong data-count="@Model.CategoryCount">@Model.CategoryCount</strong><small>Лаборатория ORM</small><div class="stat-spark mint-line"></div></article><article class="stat-card"><div class="stat-top"><span>Учебные позиции</span><i class="stat-symbol gold">▤</i></div><strong data-count="@Model.ProductCount">@Model.ProductCount</strong><small>Связаны с категориями</small><div class="stat-spark gold-line"></div></article></div>
    <div class="dashboard-grid"><section class="panel chart-panel"><div class="panel-heading"><div><h2>Состав кафедр</h2><p>Количество преподавателей по подразделениям</p></div><span class="panel-tag">БАЗА ДАННЫХ</span></div><div class="chart-wrap"><canvas id="departmentChart" data-labels='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Distribution.Select(x => x.Name)))' data-values='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Distribution.Select(x => x.Count)))'></canvas></div><div class="chart-legend">@foreach (var d in Model.Distribution) { <span><i></i>@d.Name <b>@d.Count</b></span> }</div></section>
    <section class="panel activity-panel"><div class="panel-heading"><div><h2>Недавно в системе</h2><p>Последние добавленные преподаватели</p></div><a class="text-link" asp-controller="Teachers" asp-action="Index">Все <span>→</span></a></div><div class="activity-list">@foreach (var t in Model.RecentTeachers) { <a class="activity-row" asp-controller="Teachers" asp-action="Details" asp-route-id="@t.Id"><span class="teacher-avatar">@t.FirstName[0]@t.LastName[0]</span><span class="activity-info"><strong>@t.FirstName @t.LastName</strong><small>@t.Department?.Name</small></span><span class="activity-role">@t.Position</span></a> } @if (!Model.RecentTeachers.Any()) { <div class="empty-state">Записей пока нет. Запустите приложение с подключённой базой данных.</div> }</div></section></div>
    <div class="quick-links"><a asp-controller="Teachers" asp-action="Create"><span>＋</span><div><strong>Добавить преподавателя</strong><small>Новый участник академической среды</small></div><b>→</b></a><a asp-controller="OrmLab" asp-action="Index"><span>⌬</span><div><strong>Открыть лабораторию ORM</strong><small>Категории и товары с EF Core</small></div><b>→</b></a><a asp-controller="Database" asp-action="Index"><span>▤</span><div><strong>Схема базы данных</strong><small>Изучить связи сущностей</small></div><b>→</b></a></div>
</div>
