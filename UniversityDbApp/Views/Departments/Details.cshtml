@model UniversityDbApp.Models.Department
@{ ViewData["Title"] = Model.Name; }
<div class="page-wrap"><a class="back-link" asp-action="Index">← Все кафедры</a><div class="page-heading"><div><div class="eyebrow">КАФЕДРА · @Model.Code</div><h1>@Model.Name</h1><p>@Model.Description</p></div><a class="button button-outline" asp-action="Edit" asp-route-id="@Model.Id">Изменить</a></div><div class="detail-banner"><span>ФАКУЛЬТЕТ</span><strong>@Model.Faculty</strong><span>ПРЕПОДАВАТЕЛИ</span><strong>@Model.Teachers.Count</strong><span>СОЗДАНА</span><strong>@Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</strong></div><section class="panel table-panel"><div class="panel-heading"><div><h2>Преподавательский состав</h2><p>Данные загружены через EF Core Include</p></div><a class="button button-small button-primary" asp-controller="Teachers" asp-action="Create">＋ Добавить</a></div><div class="table-scroll"><table><thead><tr><th>Имя</th><th>Должность</th><th>Степень</th><th>Email</th><th></th></tr></thead><tbody>@foreach (var t in Model.Teachers) { <tr><td><a asp-controller="Teachers" asp-action="Details" asp-route-id="@t.Id">@t.FirstName @t.LastName</a></td><td>@t.Position</td><td>@t.AcademicDegree</td><td>@t.Email</td><td><a class="row-action" asp-controller="Teachers" asp-action="Edit" asp-route-id="@t.Id">Редактировать</a></td></tr> }</tbody></table></div></section></div>
