@model IEnumerable<UniversityDbApp.Models.Department>
@{ ViewData["Title"] = "Кафедры"; }
<div class="page-wrap"><div class="page-heading"><div><div class="eyebrow">АКАДЕМИЧЕСКАЯ СТРУКТУРА</div><h1>Кафедры</h1><p>Подразделения и связанные с ними преподаватели.</p></div><a class="button button-primary" asp-action="Create">＋ Создать кафедру</a></div><div class="department-grid">@foreach (var d in Model) { <article class="department-card"><div class="dept-card-top"><span class="dept-code">@d.Code</span><span class="card-more">↗</span></div><h2>@d.Name</h2><p>@d.Description</p><div class="dept-meta"><span>@d.Faculty</span><strong>@d.Teachers.Count <small>преподавателей</small></strong></div><div class="dept-actions"><a class="text-link" asp-action="Details" asp-route-id="@d.Id">Открыть кафедру <span>→</span></a><div><a asp-action="Edit" asp-route-id="@d.Id">Изменить</a><a asp-action="Delete" asp-route-id="@d.Id">Удалить</a></div></div></article> } @if (!Model.Any()) { <div class="panel empty-state">Нет кафедр в базе данных.</div> }</div></div>
