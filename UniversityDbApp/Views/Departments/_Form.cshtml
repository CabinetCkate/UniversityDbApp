@model UniversityDbApp.Models.Department
<div asp-validation-summary="ModelOnly" class="validation"></div><input asp-for="Id" type="hidden" /><div class="form-grid"><div class="field"><label asp-for="Name">Название кафедры</label><input asp-for="Name" placeholder="Например, Информатика" /><span asp-validation-for="Name"></span></div><div class="field"><label asp-for="Code">Код</label><input asp-for="Code" placeholder="CS" /><span asp-validation-for="Code"></span></div><div class="field field-full"><label asp-for="Faculty">Факультет</label><input asp-for="Faculty" placeholder="Факультет цифровых технологий" /><span asp-validation-for="Faculty"></span></div><div class="field field-full"><label asp-for="Description">Описание</label><textarea asp-for="Description" rows="4" placeholder="Кратко об академическом направлении"></textarea><span asp-validation-for="Description"></span></div></div>
